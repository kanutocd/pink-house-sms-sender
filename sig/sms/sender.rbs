module Sms
  module Sender
    class Error < StandardError
    end

    module Capabilities
      KNOWN: Array[Symbol]

      def self.normalize: (Array[Symbol | String] values) -> Array[Symbol]
    end

    def self.registry: () -> ProviderRegistry
    def self.providers: () -> Array[Symbol]
    def self.configure_provider: (Symbol | String name, ?settings: Hash[untyped, untyped], ?enabled: bool, ?priority: Integer, ?capabilities: Array[Symbol]?) -> ProviderConfiguration
    def self.deliver: (to: String, message: String, ?provider: (Symbol | String)?, ?metadata: Hash[untyped, untyped], ?requirements: Array[Symbol]) -> Delivery

    VERSION: String

    module Errors
      FAILOVER_CATEGORIES: Array[Symbol]
      RETRYABLE_CATEGORIES: Array[Symbol]

      class Base < Error
        attr_reader category: Symbol
        attr_reader provider: Symbol?

        def initialize: (?String?, ?category: Symbol?, ?provider: Symbol?) -> void
        def retryable?: () -> bool
        def failover?: () -> bool
      end

      class ProviderError < Base
      end

      class Network < ProviderError
      end

      class Timeout < ProviderError
      end

      class RateLimited < ProviderError
      end

      class Authentication < ProviderError
      end

      class Authorization < ProviderError
      end

      class InvalidRequest < Base
      end

      class InvalidRecipient < Base
      end

      class ProviderUnavailable < ProviderError
      end

      class ProviderRejected < Base
      end

      class Unknown < Base
      end

      class ConfigurationError < Base
      end
    end

    class Message
      attr_reader to: String
      attr_reader body: String
      attr_reader metadata: Hash[untyped, untyped]
      attr_reader requirements: Array[Symbol]

      def initialize: (to: String, body: String, ?metadata: Hash[untyped, untyped], ?requirements: Array[Symbol]) -> void
    end

    class Delivery
      STATUSES: Array[Symbol]
      attr_reader status: Symbol
      attr_reader provider: Symbol?
      attr_reader provider_message_id: String?
      attr_reader attempts: Array[Hash[untyped, untyped]]
      attr_reader error: Errors::Base?
      attr_reader metadata: Hash[untyped, untyped]

      def initialize: (?status: Symbol, ?provider: Symbol?, ?provider_message_id: untyped, ?attempts: Array[Hash[untyped, untyped]], ?error: Errors::Base?, ?metadata: Hash[untyped, untyped]) -> void
      def accepted?: () -> bool
      def delivered?: () -> bool
      def failed?: () -> bool
    end

    class ProviderConfiguration
      attr_reader name: Symbol
      attr_reader settings: Hash[untyped, untyped]
      attr_reader enabled: bool
      attr_reader priority: Integer
      attr_reader capabilities: Array[Symbol]

      def initialize: (name: Symbol | String, ?settings: Hash[untyped, untyped], ?enabled: bool, ?priority: Integer, ?capabilities: Array[Symbol]) -> void
      def []: (Symbol | String) -> untyped
      def enabled?: () -> bool
    end

    class Provider
      attr_reader configuration: ProviderConfiguration

      def initialize: (configuration: ProviderConfiguration) -> void
      def name: () -> Symbol
      def capabilities: () -> Array[Symbol]
      def deliver: (untyped) -> untyped
    end

    class Router
      def initialize: (?registry: ProviderRegistry, ?circuit_options: Hash[Symbol, untyped]) -> void
      def deliver: (Message message, ?provider: (Symbol | String)?, ?max_attempts: Integer?) -> Delivery
      def health: (Symbol | String name) -> Hash[Symbol, untyped]
    end

    class CircuitBreaker
      STATES: Array[Symbol]
      DEFAULT_FAILURE_THRESHOLD: Integer
      DEFAULT_OBSERVATION_WINDOW: Integer
      DEFAULT_OPEN_COOLDOWN: Integer
      DEFAULT_HALF_OPEN_PROBE_LIMIT: Integer

      def initialize: (?failure_threshold: Integer, ?observation_window: Numeric, ?open_cooldown: Numeric, ?half_open_probe_limit: Integer, ?clock: ^() -> Numeric) -> void
      def state: () -> Symbol
      def allow?: () -> bool
      def record_success: () -> void
      def record_failure: (Errors::Base error) -> void
    end

    class Health
      def initialize: (?observation_window: Numeric, ?clock: ^() -> Numeric) -> void
      def record_success: (latency: Numeric, ?circuit_state: Symbol) -> void
      def record_failure: (latency: Numeric, error: Errors::Base, ?circuit_state: Symbol) -> void
      def snapshot: () -> Hash[Symbol, untyped]
    end

    class Election
      def rank: (Array[Provider] providers, ?requirements: Array[Symbol], ?circuits: Hash[Symbol, CircuitBreaker], ?health: Hash[Symbol, Health]) -> Array[Provider]
    end

    class ProviderRegistry
      DEFAULT_PROVIDERS: Hash[Symbol, String]

      def initialize: (?catalog: Hash[Symbol | String, String]) -> void
      def supported: () -> Array[Symbol]
      def configured: () -> Array[Symbol]
      def register: (Symbol | String name, loader: ^() -> Class, ?capabilities: Array[Symbol]) -> Symbol
      def configure: (Symbol | String name, ?settings: Hash[untyped, untyped], ?enabled: bool, ?priority: Integer, ?capabilities: Array[Symbol]?) -> ProviderConfiguration
      def provider: (Symbol | String name) -> Provider
      def providers: () -> Array[Provider]
    end

    module HTTP
      class Response
        attr_reader status: Integer
        attr_reader headers: Hash[String, String]
        attr_reader body: String

        def initialize: (status: Integer, ?headers: Hash[untyped, untyped], ?body: untyped) -> void
        def successful?: () -> bool
      end

      class NetHttpTransport
        def initialize: (?http_factory: ^(URI::Generic) -> untyped) -> void
        def call: (method: Symbol | String, url: String, headers: Hash[String, String], body: String?, open_timeout: Numeric, read_timeout: Numeric, write_timeout: Numeric) -> Response
      end

      class Client
        DEFAULT_OPEN_TIMEOUT: Integer
        DEFAULT_READ_TIMEOUT: Integer
        DEFAULT_WRITE_TIMEOUT: Integer

        def initialize: (?transport: untyped, ?open_timeout: Numeric, ?read_timeout: Numeric, ?write_timeout: Numeric, ?total_timeout: Numeric?) -> void
        def request: (Symbol | String method, String url, ?headers: Hash[untyped, untyped], ?body: String | Hash[untyped, untyped]?) -> Response
        def redacted_headers: (Hash[untyped, untyped] headers) -> Hash[String, String]
      end
    end

    module Providers
      class TextBee < Provider
        BASE_URL: String
        SEND_PATH: String

        def initialize: (configuration: ProviderConfiguration, ?http: HTTP::Client) -> void
        def deliver: (Message message) -> Delivery
      end

      class Semaphore < Provider
        BASE_URL: String
        SEND_PATH: String

        def initialize: (configuration: ProviderConfiguration, ?http: HTTP::Client) -> void
        def deliver: (Message message) -> Delivery
      end

      class Twilio < Provider
        BASE_URL: String
        SEND_PATH: String

        def initialize: (configuration: ProviderConfiguration, ?http: HTTP::Client) -> void
        def deliver: (Message message) -> Delivery
      end

      class Infobip < Provider
        BASE_URL: String
        SEND_PATH: String

        def initialize: (configuration: ProviderConfiguration, ?http: HTTP::Client) -> void
        def deliver: (Message message) -> Delivery
      end
    end
  end
end
